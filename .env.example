# ==================== BACKEND ====================
# Base de datos
DATABASE_URL=postgresql://user:password@db:5432/educert_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=educert_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Certify API

# JWT
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Seguridad (para hashing de contraseñas)
BCRYPT_ROUNDS=12

# Superusuario inicial (se crea al arrancar si no existe)
SUPERUSER_EMAIL=admin@certify.local
SUPERUSER_PASSWORD=Ch4ng3M3!
SUPERUSER_NAME=Admin
SUPERUSER_FIRST_LAST_NAME=Certify
SUPERUSER_IDENTITY_TYPE=CC
SUPERUSER_IDENTITY_NUMBER=0000000000
SUPERUSER_PHONE_NUMBER=+570000000000

SYSTEM_BOT_USER_EMAIL=system@certify.com
SYSTEM_BOT_USER_NAME=System
SYSTEM_BOT_USER_FIRST_LAST_NAME=Bot

# Almacenamiento local (otros usos; certificados solo MinIO)
STORAGE_PATH=/app/storage  # dentro del contenedor
BASE_URL=https://tudominio.com  # para URLs públicas de verificación y descarga

# Plantillas PDF de certificado (rutas relativas al paquete app/ o absolutas)
CERTIFICATE_TEMPLATE_PDF=templates/certificate_template.pdf
CERTIFICATE_REFERENCE_PDF=templates/certificate_reference.pdf
CERTIFICATE_REVOKED_WATERMARK_TEXT=REVOCADO

# MinIO (API suele exponerse en local vía túnel SSH, p. ej. ssh -L 9000:127.0.0.1:9000 user@vps)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=certify
MINIO_PATH_PDF=certifications/pdf
MINIO_PATH_QR=certifications/qr
MINIO_PATH_BACKUP_DB=backup/database
MINIO_PATH_BACKUP_CERT=backup/certificates
MINIO_PATH_TASKS=tasks/files
MINIO_SECURE=False
MINIO_REGION=

# Generación de PDF y QR
QR_SIZE=200  # píxeles
PDF_TEMPLATE_PATH=/app/templates/certificate.html

# Email (notificaciones de expiración)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-contraseña-o-app-password
SMTP_TLS=True
EMAIL_FROM=noreply@tudominio.com

# Tareas programadas (check expirados cada X horas)
CHECK_EXPIRED_INTERVAL_HOURS=24

# Entorno
ENVIRONMENT=development  # development / production
DEBUG=True

# CORS (orígenes permitidos)
CORS_ORIGINS=["http://localhost:3000", "https://tudominio.com"]

# Tamaño máximo de archivos de tareas (en MB)
TASK_MAX_UPLOAD_SIZE_MB=50

# ==================== FRONTEND (React) ====================
# Estas variables se usan en tiempo de build; deben tener prefijo REACT_APP_
REACT_APP_API_URL=http://localhost:8000/api   # o https://tudominio.com/api
REACT_APP_VERIFY_BASE_URL=https://tudominio.com/verify

# ==================== BROKER CONFIG  ====================
RABBITMQ_URL=amqp://user:pass@host:5672//