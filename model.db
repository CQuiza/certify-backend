CREATE TABLE email_audit (
	id SERIAL NOT NULL, 
	user_name VARCHAR(255), 
	email_to VARCHAR(255) NOT NULL, 
	email_type VARCHAR(50) NOT NULL, 
	status VARCHAR(20) NOT NULL, 
	error TEXT, 
	metadata JSONB, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	sent_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_email_audit PRIMARY KEY (id)
);

CREATE TABLE users (
	id SERIAL NOT NULL, 
	email VARCHAR(255) NOT NULL, 
	password_hash VARCHAR(255) NOT NULL, 
	name VARCHAR(255) NOT NULL, 
	first_last_name VARCHAR(255) NOT NULL, 
	second_last_name VARCHAR(255), 
	role VARCHAR(50) NOT NULL, 
	identity_type VARCHAR(50) NOT NULL, 
	identity_number VARCHAR(50) NOT NULL, 
	phone_number VARCHAR(20) NOT NULL, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	is_active BOOLEAN DEFAULT 'true' NOT NULL, 
	refresh_token_hash TEXT, 
	refresh_token_expires_at TIMESTAMP WITH TIME ZONE, 
	failed_login_attempts INTEGER NOT NULL, 
	locked_until TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_users PRIMARY KEY (id), 
	CONSTRAINT ck_users_role CHECK (role IN ('superuser', 'admin', 'teacher', 'student')), 
	CONSTRAINT ck_users_identity_type CHECK (identity_type IN ('CC', 'TI', 'CE', 'PPT', 'PASSPORT', 'OTHER')), 
	CONSTRAINT users_email_key UNIQUE (email), 
	CONSTRAINT users_identity_number_key UNIQUE (identity_number), 
	CONSTRAINT users_phone_number_key UNIQUE (phone_number)
);

CREATE TABLE worker_audit (
	id SERIAL NOT NULL, 
	task_name VARCHAR(100) NOT NULL, 
	status VARCHAR(20) NOT NULL, 
	started_at TIMESTAMP WITH TIME ZONE, 
	finished_at TIMESTAMP WITH TIME ZONE, 
	details TEXT, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	CONSTRAINT pk_worker_audit PRIMARY KEY (id)
);

CREATE TABLE certificate_types (
	id SERIAL NOT NULL, 
	name VARCHAR(255) NOT NULL, 
	reference TEXT, 
	type VARCHAR(20) NOT NULL, 
	hours INTEGER NOT NULL, 
	validity_type VARCHAR(50) NOT NULL, 
	validity_value INTEGER NOT NULL, 
	created_by INTEGER, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	CONSTRAINT pk_certificate_types PRIMARY KEY (id), 
	CONSTRAINT ck_certificate_types_type CHECK (type IN ('basic', 'advanced', 'diploma')), 
	CONSTRAINT ck_certificate_types_validity_type CHECK (validity_type IN ('years', 'months', 'days')), 
	CONSTRAINT fk_certificate_types_created_by_users FOREIGN KEY(created_by) REFERENCES users (id)
);

CREATE TABLE courses (
	id SERIAL NOT NULL, 
	title VARCHAR(255) NOT NULL, 
	description TEXT, 
	certificate_type_id INTEGER, 
	teacher_id INTEGER, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	status VARCHAR(20) DEFAULT 'draft' NOT NULL, 
	CONSTRAINT pk_courses PRIMARY KEY (id), 
	CONSTRAINT ck_courses_status CHECK (status IN ('draft', 'published', 'archived')), 
	CONSTRAINT fk_courses_teacher_id_users FOREIGN KEY(teacher_id) REFERENCES users (id) ON DELETE SET NULL
);

CREATE TABLE user_audit (
	id SERIAL NOT NULL, 
	user_id INTEGER, 
	deleted_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	deleted_by INTEGER, 
	snapshot JSONB NOT NULL, 
	CONSTRAINT pk_user_audit PRIMARY KEY (id), 
	CONSTRAINT fk_user_audit_deleted_by_users FOREIGN KEY(deleted_by) REFERENCES users (id) ON DELETE SET NULL
);

CREATE TABLE certificates (
	id SERIAL NOT NULL, 
	unique_id UUID DEFAULT gen_random_uuid() NOT NULL, 
	certificate_type_id INTEGER, 
	user_id INTEGER, 
	issued_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	expires_at TIMESTAMP WITH TIME ZONE, 
	hours INTEGER, 
	validity_years INTEGER, 
	status VARCHAR(20) DEFAULT 'active' NOT NULL, 
	qr_code_url VARCHAR(255), 
	pdf_url VARCHAR(255), 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	updated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	CONSTRAINT pk_certificates PRIMARY KEY (id), 
	CONSTRAINT ck_certificates_status CHECK (status IN ('active', 'revoked', 'expired')), 
	CONSTRAINT certificates_unique_id_key UNIQUE (unique_id), 
	CONSTRAINT fk_certificates_certificate_type_id_certificate_types FOREIGN KEY(certificate_type_id) REFERENCES certificate_types (id), 
	CONSTRAINT fk_certificates_user_id_users FOREIGN KEY(user_id) REFERENCES users (id) ON DELETE CASCADE
);

COMMENT ON COLUMN certificates.hours IS 'Override de intensidad horaria (NULL = sigue el tipo)';

COMMENT ON COLUMN certificates.validity_years IS 'Override de vigencia en años (NULL = sigue el tipo)';

CREATE TABLE course_enrollments (
	id SERIAL NOT NULL, 
	user_id INTEGER NOT NULL, 
	course_id INTEGER NOT NULL, 
	enrolled_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	CONSTRAINT pk_course_enrollments PRIMARY KEY (id), 
	CONSTRAINT uq_enrollment_user_course UNIQUE (user_id, course_id), 
	CONSTRAINT fk_course_enrollments_user_id_users FOREIGN KEY(user_id) REFERENCES users (id) ON DELETE CASCADE, 
	CONSTRAINT fk_course_enrollments_course_id_courses FOREIGN KEY(course_id) REFERENCES courses (id) ON DELETE CASCADE
);

CREATE TABLE modules (
	id SERIAL NOT NULL, 
	course_id INTEGER NOT NULL, 
	title VARCHAR(255) NOT NULL, 
	order_index INTEGER NOT NULL, 
	CONSTRAINT pk_modules PRIMARY KEY (id), 
	CONSTRAINT uq_module_course_order UNIQUE (course_id, order_index), 
	CONSTRAINT fk_modules_course_id_courses FOREIGN KEY(course_id) REFERENCES courses (id) ON DELETE CASCADE
);

CREATE TABLE certificate_audit (
	id SERIAL NOT NULL, 
	certificate_id INTEGER, 
	certificate_unique_id UUID, 
	action VARCHAR(50), 
	performed_by INTEGER, 
	timestamp TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	CONSTRAINT pk_certificate_audit PRIMARY KEY (id), 
	CONSTRAINT fk_certificate_audit_certificate_id_certificates FOREIGN KEY(certificate_id) REFERENCES certificates (id) ON DELETE SET NULL, 
	CONSTRAINT fk_certificate_audit_performed_by_users FOREIGN KEY(performed_by) REFERENCES users (id)
);

CREATE TABLE lessons (
	id SERIAL NOT NULL, 
	module_id INTEGER NOT NULL, 
	title VARCHAR(255) NOT NULL, 
	text_content TEXT, 
	image_content_url TEXT, 
	video_content_url TEXT, 
	file_content_url TEXT, 
	order_index INTEGER NOT NULL, 
	CONSTRAINT pk_lessons PRIMARY KEY (id), 
	CONSTRAINT uq_lesson_module_order UNIQUE (module_id, order_index), 
	CONSTRAINT fk_lessons_module_id_modules FOREIGN KEY(module_id) REFERENCES modules (id) ON DELETE CASCADE
);

CREATE TABLE module_assessments (
	id SERIAL NOT NULL, 
	module_id INTEGER NOT NULL, 
	passing_score INTEGER NOT NULL, 
	CONSTRAINT pk_module_assessments PRIMARY KEY (id), 
	CONSTRAINT module_assessments_module_id_key UNIQUE (module_id), 
	CONSTRAINT fk_module_assessments_module_id_modules FOREIGN KEY(module_id) REFERENCES modules (id) ON DELETE CASCADE
);

CREATE TABLE pending_certificates (
	id SERIAL NOT NULL, 
	user_id INTEGER NOT NULL, 
	course_id INTEGER NOT NULL, 
	certificate_type_id INTEGER, 
	status VARCHAR(20) DEFAULT 'in_progress' NOT NULL, 
	created_by INTEGER, 
	issued_at_override TIMESTAMP WITH TIME ZONE, 
	validity_extension INTEGER, 
	hours INTEGER, 
	issued_certificate_id INTEGER, 
	created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
	issued_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_pending_certificates PRIMARY KEY (id), 
	CONSTRAINT uq_pending_user_course UNIQUE (user_id, course_id), 
	CONSTRAINT ck_pending_certificates_status CHECK (status IN ('in_progress', 'issued')), 
	CONSTRAINT fk_pending_certificates_user_id_users FOREIGN KEY(user_id) REFERENCES users (id) ON DELETE CASCADE, 
	CONSTRAINT fk_pending_certificates_course_id_courses FOREIGN KEY(course_id) REFERENCES courses (id) ON DELETE CASCADE, 
	CONSTRAINT fk_pending_certificates_certificate_type_id_certificate_types FOREIGN KEY(certificate_type_id) REFERENCES certificate_types (id), 
	CONSTRAINT fk_pending_certificates_created_by_users FOREIGN KEY(created_by) REFERENCES users (id) ON DELETE SET NULL, 
	CONSTRAINT fk_pending_certificates_issued_certificate_id_certificates FOREIGN KEY(issued_certificate_id) REFERENCES certificates (id) ON DELETE SET NULL
);

CREATE TABLE assessment_questions (
	id SERIAL NOT NULL, 
	assessment_id INTEGER NOT NULL, 
	question_text TEXT NOT NULL, 
	question_type VARCHAR(20) NOT NULL, 
	points INTEGER NOT NULL, 
	order_index INTEGER NOT NULL, 
	CONSTRAINT pk_assessment_questions PRIMARY KEY (id), 
	CONSTRAINT fk_assessment_questions_assessment_id_module_assessments FOREIGN KEY(assessment_id) REFERENCES module_assessments (id) ON DELETE CASCADE
);

CREATE TABLE lesson_files (
	id SERIAL NOT NULL, 
