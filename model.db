	finished_at TIMESTAMP WITH TIME ZONE, 
	CONSTRAINT pk_user_assessment_attempts PRIMARY KEY (id), 
	CONSTRAINT fk_user_assessment_attempts_assessment_id_module_assessments FOREIGN KEY(assessment_id) REFERENCES module_assessments (id) ON DELETE CASCADE, 
