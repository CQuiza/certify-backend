	is_correct BOOLEAN NOT NULL, 
	CONSTRAINT pk_user_assessment_answers PRIMARY KEY (id), 
	CONSTRAINT user_assessment_answers_attempt_id_question_id_key UNIQUE (attempt_id, question_id), 
